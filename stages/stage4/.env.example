# Copy this file to .env and edit it. Never commit .env
#
# true  = no API key needed, canned replies. Good for building and testing.
# false = call the real API. Requires ANTHROPIC_API_KEY below.
USE_MOCK=true

ANTHROPIC_API_KEY=

# claude-opus-5     strongest
# claude-haiku-4-5  much cheaper, fast, fine for short explanations
CLAUDE_MODEL=claude-haiku-4-5
